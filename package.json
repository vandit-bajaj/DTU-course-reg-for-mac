{
  "name": "dtu-course-registrar",
  "version": "1.0.0",
  "description": "Automated course seat monitor and registrar for DTU students — snipes elective seats the moment they open.",
  "main": "main.js",
  "author": {
    "name": "Vandit Bajaj",
    "email": "vanditbajaj15@gmail.com",
    "url": "https://github.com/vandit-bajaj"
  },
  "homepage": "https://github.com/vandit-bajaj/DTU-course-reg-for-mac",
  "repository": {
    "type": "git",
    "url": "https://github.com/vandit-bajaj/DTU-course-reg-for-mac.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.vanditbajaj.dtu-course-registrar",
    "productName": "DTU Course Registrar",
    "directories": {
      "output": "dist"
    },
    "files": ["**/*"],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "assets/dtulogo.ico"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "zip", "arch": ["arm64"] }],
      "icon": "assets/dtulogo.icns",
      "identity": null
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/dtulogo.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "got": "^14.4.5",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^24.6.0"
  }
}